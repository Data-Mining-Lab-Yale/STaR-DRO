{
  "grouping": {
    "groupby": "code",
    "granularity": "annotation",
    "min_count": 1
  },
  "star_dro": {
    "alpha": 1.2,
    "eta": 0.0006,
    "rho_start": 0.3,
    "rho_end": 0.03,
    "upper": 15.0,
