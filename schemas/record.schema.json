{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STaR-DRO input record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "source_text": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Code",
          "Sub-code",
          "Span"
        ],
        "properties": {
          "Code": {
            "type": "string",
            "minLength": 1
          },
          "Sub-code": {
            "type": "string",
            "minLength": 1
          },
          "Span": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output_format": {
      "enum": [
        "list",
        "results"
      ],
      "default": "list"
    }
  },
  "oneOf": [
    {
      "required": [
        "messages"
      ],
      "not": {
        "required": [
          "prompt"
        ]
      }
    },
    {
      "required": [
        "prompt"
      ],
      "not": {
        "required": [
          "messages"
        ]
      }
    }
  ]
}
